{
  "name": "finsweet",
  "version": "0.1.0",
  "private": true,
  "description": "Classic WordPress theme with custom blocks, based on the Finsweet Client-First blog template.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denys-khrapov/finsweet.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "lint:php": "composer lint",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"theme/blocks/**/*.scss\"",
    "lint:js": "wp-scripts lint-js src webpack.config.js",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:php"
  },
  "devDependencies": {
    "@wordpress/scripts": "^36.0.0"
  },
  "dependencies": {
    "swiper": "^14.3.0"
  }
}
